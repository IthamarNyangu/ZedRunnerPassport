  vec2 distortedUVA = uvA + vec2(warpX, warpY) * 0.2;

  vec2 noiseUV = distortedUVA * stretch;

  vec2 rotNoiseUV = rotate(noiseUV - center, t * 0.065) + center;
  float n1raw = fbm(rotNoiseUV * 0.075);
  float n1 = smoothstep(0.38, 0.62, n1raw * 0.5 + 0.5);

  vec2 rotNoiseUV2 = rotate(noiseUV - center, t * -0.055 + 2.0) + center;
  float n2raw = fbm(rotNoiseUV2 * 0.095);
  float n2 = smoothstep(0.38, 0.62, n2raw * 0.5 + 0.5);

  vec3 palette;
  float ramp = n1;
  if (ramp < 0.2) {
    palette = mix(u_color1, u_color2, smoothstep(0.0, 0.2, ramp));
  } else if (ramp < 0.4) {
    palette = mix(u_color2, u_color3, smoothstep(0.2, 0.4, ramp));
  } else if (ramp < 0.6) {
    palette = mix(u_color3, u_color4, smoothstep(0.4, 0.6, ramp));
  } else if (ramp < 0.8) {
    palette = mix(u_color4, u_color5, smoothstep(0.6, 0.8, ramp));
  } else {
    palette = mix(u_color5, u_color6, smoothstep(0.8, 1.0, ramp));
  }

  vec3 palette2 = mix(u_color1, u_color4, n2);
  palette = mix(palette, palette2, 0.15);

  float hueNoise = snoise(distortedUVA * 1.5 + t * 0.025) * u_hue_shift;
  float satNoise = 1.0 + snoise(distortedUVA * 1.2 + t * 0.035 + 10.0) * u_hue_shift * 1.67;
  palette = hueShift(palette, hueNoise, satNoise);

  palette = pow(palette, vec3(0.75));

  float intensity = smoothstep(0.0, 0.4, n1);
  col = mix(bgColor, palette, 0.7 + intensity * 0.3);

  vec2 circleCenter = center + vec2(
    sin(t * 0.1 + 1.0) * 0.12,
    cos(t * 0.08 + 2.0) * 0.1
  );
  float dist = length(distortedUVA - circleCenter);
  float circleMask = 1.0 - smoothstep(0.0, 0.7, dist);
  vec3 circleColor = mix(u_color5, u_color3, 0.4);
  col = mix(col, circleColor, circleMask * 0.4);

  vec2 blob2Center = center + vec2(
    cos(t * 0.09 + 4.0) * 0.18,
    sin(t * 0.11 + 3.0) * 0.14
  );
  float dist2 = length(distortedUVA - blob2Center);
  float blob2Mask = 1.0 - smoothstep(0.0, 0.6, dist2);
  col = mix(col, u_color2, blob2Mask * 0.35);

  vec2 blob3Center = center + vec2(
    sin(t * 0.065 + 6.0) * 0.2,
    cos(t * 0.08 + 5.0) * 0.16
  );
  float dist3 = length(distortedUVA - blob3Center);
  float blob3Mask = 1.0 - smoothstep(0.0, 0.55, dist3);
  col = mix(col, u_color6, blob3Mask * 0.25);

  vec2 rotBlendUV = rotate(distortedUVA - center, t * 0.03) + center;
  float blendNoise = snoise(rotBlendUV * 0.5);
  float blendFactor = smoothstep(-0.3, 0.3, blendNoise);
  vec3 warmBlend = mix(u_color1, u_color5, blendFactor);
  col = mix(col, warmBlend, 0.15);

  float grain = fract(sin(dot(uv * u_resolution, vec2(12.9898, 78.233)) + t * 43.758) * 43758.5453);
  col += (grain - 0.5) * u_grain;

  col = mix(col, vec3(1.0), 0.18);

  col = clamp(col, 0.0, 1.0);
  gl_FragColor = vec4(col, 1.0);
}
