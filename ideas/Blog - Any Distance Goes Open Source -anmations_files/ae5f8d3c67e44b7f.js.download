`,eW=`
precision mediump float;

uniform float u_time;
uniform vec2 u_resolution;
// Group 1 colors
uniform vec3 u_g1c1;
uniform vec3 u_g1c2;
uniform vec3 u_g1c3;
uniform vec3 u_g1c4;
// Group 2 colors
uniform vec3 u_g2c1;
uniform vec3 u_g2c2;
uniform vec3 u_g2c3;
uniform vec3 u_g2c4;
// Group 3 colors
uniform vec3 u_g3c1;
uniform vec3 u_g3c2;
uniform vec3 u_g3c3;
uniform vec3 u_g3c4;

uniform float u_tilt;
uniform float u_min_height;
uniform float u_max_height;
uniform float u_shift_speed;
uniform float u_breathe_speed;
uniform float u_gap;
uniform float u_stiffness;
uniform float u_damping;

// Real damped harmonic oscillator
// stiffness = spring constant, damping = friction
// mass is fixed at 1.0
float springEase(float t) {
  float omega = sqrt(u_stiffness);           // natural frequency
  float zeta = u_damping / (2.0 * omega);    // damping ratio
  float omegaD = omega * sqrt(1.0 - zeta * zeta); // damped frequency
  return 1.0 - exp(-zeta * omega * t) * cos(omegaD * t);
}

void main() {
  vec2 uv = gl_FragCoord.xy / u_resolution.xy;

  // 6 segments = full cycle (3 palettes x 2 tilt sides)
  // 1.5s spring transition + 4.5s hold per segment = 6s each = 36s total
  float segDuration = 6.0;
  float transitionTime = 1.5;
  float numSegs = 6.0;
  float totalCycle = segDuration * numSegs;
  float elapsed = mod(u_time, totalCycle);

  float seg = floor(elapsed / segDuration);
  float segTime = elapsed - seg * segDuration;

  // Spring-eased progress: 0->1 during transition, 1 during hold
  float t = springEase(clamp(segTime / transitionTime, 0.0, 1.0));

  // See-saw: alternates each segment, wraps cleanly over 6 (even)
  float prevTilt = mod(seg, 2.0) < 1.0 ? -u_tilt : u_tilt;
  float nextTilt = mod(seg, 2.0) < 1.0 ? u_tilt : -u_tilt;
  float tiltAngle = mix(prevTilt, nextTilt, t);

  float co = cos(tiltAngle);
  float si = sin(tiltAngle);
  vec2 centered = uv - 0.5;
  float rotY = -centered.x * si + centered.y * co + 0.5;

  // Static stripe height
  float stripeH = u_min_height;
  float totalH = stripeH * 4.0;
  float edgeOffset = stripeH * 1.5; // push groups 1.5 stripes off each edge

  // Two groups bleeding off edges, shifted outward so they clip naturally
  float topAnchor = 1.0 + edgeOffset;
  float bottomAnchor = 0.0 - edgeOffset;

  float stripeIndex = -1.0;
  if (rotY > topAnchor - totalH) {
    // Top group: stripe 0 starts above top edge, stripes go down
    float pos = topAnchor - rotY;
    float idx = floor(pos / stripeH);
    if (idx >= 0.0 && idx <= 3.0) stripeIndex = idx;
  }
  if (stripeIndex < 0.0 && rotY < bottomAnchor + totalH) {
    // Bottom group: stripe 0 starts below bottom edge, stripes go up
    float pos = rotY - bottomAnchor;
    float idx = floor(pos / stripeH);
    if (idx >= 0.0 && idx <= 3.0) stripeIndex = idx;
  }
  if (stripeIndex < 0.0) {
    // White gap in the middle
    gl_FragColor = vec4(1.0, 1.0, 1.0, 1.0);
    return;
  }

  // Palette cycle: p1->p2->p3->p1->p2->p3 over 6 segments
  float paletteSeg = mod(seg, 3.0);
  vec3 colA, colB;
  if (paletteSeg < 1.0) {
    if (stripeIndex < 1.0) { colA = u_g1c1; colB = u_g2c1; }
    else if (stripeIndex < 2.0) { colA = u_g1c2; colB = u_g2c2; }
    else if (stripeIndex < 3.0) { colA = u_g1c3; colB = u_g2c3; }
    else { colA = u_g1c4; colB = u_g2c4; }
  } else if (paletteSeg < 2.0) {
    if (stripeIndex < 1.0) { colA = u_g2c1; colB = u_g3c1; }
    else if (stripeIndex < 2.0) { colA = u_g2c2; colB = u_g3c2; }
    else if (stripeIndex < 3.0) { colA = u_g2c3; colB = u_g3c3; }
    else { colA = u_g2c4; colB = u_g3c4; }
  } else {
    if (stripeIndex < 1.0) { colA = u_g3c1; colB = u_g1c1; }
    else if (stripeIndex < 2.0) { colA = u_g3c2; colB = u_g1c2; }
    else if (stripeIndex < 3.0) { colA = u_g3c3; colB = u_g1c3; }
    else { colA = u_g3c4; colB = u_g1c4; }
  }

  vec3 col = mix(colA, colB, t);
  col = mix(vec3(1.0), col, 0.77);
  gl_FragColor = vec4(col, 1.0);
}
