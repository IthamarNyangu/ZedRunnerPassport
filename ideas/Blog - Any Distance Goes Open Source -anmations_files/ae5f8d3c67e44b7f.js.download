#define FLOW_R2         0.12

#define DARK_MUL        0.5
#define MID_MUL         1.1
#define BRIGHT_MUL      1.8
#define BRIGHT_BLEND    0.7
#define LAVENDER        vec3(0.27, 0.0, 1.0)
#define REFRACT_TINT    vec3(0.7, 0.15, 1.0)

#define CAUSTIC_EPS     0.025
#define CAUSTIC_THRESH  0.10
#define CAUSTIC_POW     3.5
#define CAUSTIC_STRENGTH 0.45
#define CAUSTIC_COLOR   vec3(0.8, 0.2, 1.0)

#define IRI_STRENGTH    0.25
#define IRI_SCALE       7.5
#define IRI_VIOLET      vec3(0.27, 0.0, 1.0)
#define IRI_INDIGO      vec3(0.75, 0.2, 1.0)

#define VIGNETTE_POW    0.925
#define VIGNETTE_MIX    0.5

float hash(vec2 p) {
  float h = dot(p, vec2(127.1, 311.7));
  return fract(sin(h) * 43758.5453);
}

float noise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float a = hash(i);
  float b = hash(i + vec2(1.0, 0.0));
  float c = hash(i + vec2(0.0, 1.0));
  float d = hash(i + vec2(1.0, 1.0));
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(vec2 p) {
  float v = 0.0, a = 0.5;
  mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);
  for (int i = 0; i < OCTAVES; i++) {
    v += a * noise(p);
    p = rot * p * 2.0;
    a *= 0.5;
  }
  return v;
}

void main() {
  vec2 uv = gl_FragCoord.xy / u_resolution.xy;
  float aspect = u_resolution.x / u_resolution.y;
  vec2 center = (uv - 0.5) * vec2(aspect, 1.0);
  vec2 p = center * ZOOM;
  float t = u_time * SPEED;

  float a1 = t * FLOW_Q1;
  float a2 = t * FLOW_Q2;
  vec2 drift1 = vec2(cos(a1), sin(a1)) * 1.0;
  vec2 drift2 = vec2(sin(a2), -cos(a2)) * 1.0;

  vec2 q = vec2(
    fbm(p + drift1),
    fbm(p + vec2(5.2, 1.3) + drift2)
  );

  float a3 = t * FLOW_R1 * 2.0;
  vec2 drift3 = vec2(-sin(a3), cos(a3)) * 0.8;
  vec2 drift4 = vec2(cos(a3 * 0.7), sin(a3 * 0.7)) * 0.8;

  vec2 r = vec2(
    fbm(p + q * WARP_STRENGTH + vec2(1.7, 9.2) + drift3),
    fbm(p + q * WARP_STRENGTH + vec2(8.3, 2.8) + drift4)
  );

  float f = fbm(p + r * WARP_STRENGTH);

  vec3 lav = LAVENDER * DARK_MUL;
  vec3 mid = u_color * MID_MUL;
  vec3 bright = u_color * BRIGHT_MUL;

  float q2 = fbm(p * 0.8 + vec2(cos(t * 0.3), sin(t * 0.3)) * 0.5 + 3.7);
  vec3 refr = mix(lav, REFRACT_TINT, q2);

  vec3 col = mix(refr, mid, smoothstep(0.05, 0.65, f));
  col = mix(col, bright, smoothstep(0.35, 1.0, f) * BRIGHT_BLEND);

  vec2 wp = p + r * WARP_STRENGTH;
  float caustic = abs(fbm(wp + vec2(CAUSTIC_EPS, 0.0)) - fbm(wp - vec2(CAUSTIC_EPS, 0.0)))
               + abs(fbm(wp + vec2(0.0, CAUSTIC_EPS)) - fbm(wp - vec2(0.0, CAUSTIC_EPS)));
  caustic = pow(1.0 - smoothstep(0.0, CAUSTIC_THRESH, caustic), CAUSTIC_POW);
  col += CAUSTIC_COLOR * caustic * CAUSTIC_STRENGTH;

  float hueShift = length(r - q) * IRI_SCALE;
  vec3 iri = mix(IRI_VIOLET, IRI_INDIGO, sin(hueShift * 3.14) * 0.5 + 0.5);
  col = mix(col, col * iri * 2.0, IRI_STRENGTH);

  float grain = hash(uv * u_resolution.xy + fract(u_time) * 1000.0) - 0.5;
  col += grain * 0.04;

  float vig = pow(16.0 * uv.x * uv.y * (1.0 - uv.x) * (1.0 - uv.y), VIGNETTE_POW);
  col = mix(vec3(0.0), col, vig * VIGNETTE_MIX + VIGNETTE_MIX);

  gl_FragColor = vec4(sqrt(clamp(col, 0.0, 1.0)), 1.0);
}
