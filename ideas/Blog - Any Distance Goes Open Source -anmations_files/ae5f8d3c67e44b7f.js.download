#ifdef GL_FRAGMENT_PRECISION_HIGH
  precision highp float;
#else
  precision mediump float;
#endif

uniform float u_time;
uniform vec2 u_resolution;
uniform vec3 u_color;

#define ZOOM            0.15
#define SPEED           0.08
#define OCTAVES         3
#define WARP_STRENGTH   5.0
#define FLOW_Q1         0.4
#define FLOW_Q2         0.3
