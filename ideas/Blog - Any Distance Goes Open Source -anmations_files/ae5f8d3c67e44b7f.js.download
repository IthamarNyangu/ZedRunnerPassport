`,el=`
#ifdef GL_FRAGMENT_PRECISION_HIGH
  precision highp float;
#else
  precision mediump float;
#endif

uniform float u_time;
uniform vec2 u_resolution;
uniform vec3 u_c1;
uniform vec3 u_c2;
uniform vec3 u_c3;
uniform vec3 u_c4;
uniform vec3 u_c5;
uniform vec3 u_c6;

#define SPEED         0.4
#define ORB_RADIUS    0.22
#define SOFTNESS      5.0
#define WARP_AMOUNT   0.35
#define WARP_SCALE    4.5
#define BREATHE_AMP   0.15
#define BREATHE_SPEED 0.4
#define REFRACT_STR   0.12
#define REFRACT_SCALE 5.0

float hash(vec2 p) {
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float noise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float a = hash(i);
  float b = hash(i + vec2(1.0, 0.0));
  float c = hash(i + vec2(0.0, 1.0));
  float d = hash(i + vec2(1.0, 1.0));
  return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(vec2 p) {
  float v = 0.0, a = 0.5;
  mat2 rot = mat2(0.8, 0.6, -0.6, 0.8);
  for (int i = 0; i < 3; i++) {
    v += a * noise(p);
    p = rot * p * 2.0;
    a *= 0.5;
  }
  return v;
}

float orb(vec2 pos, vec2 center, float radius, float seed, float t) {
  vec2 offset = pos - center;
  float n = fbm(pos * WARP_SCALE + seed + t * 0.2);
  offset += (n - 0.5) * WARP_AMOUNT;
  float d = length(offset) / radius;
  return exp(-d * d * SOFTNESS);
}

void main() {
  vec2 uv = gl_FragCoord.xy / u_resolution.xy;
  uv = (uv - 0.5) / 3.0 + 0.5;
  float aspect = u_resolution.x / u_resolution.y;
  vec2 pos = vec2(uv.x * aspect, uv.y);
  float cx = 0.5 * aspect;
  float cy = 0.5;
  float t = u_time * SPEED;

  float b1 = 1.0 + sin(t * BREATHE_SPEED * 6.28) * BREATHE_AMP;
  float b2 = 1.0 + sin(t * BREATHE_SPEED * 6.28 + 1.0) * BREATHE_AMP;
  float b3 = 1.0 + sin(t * BREATHE_SPEED * 6.28 + 2.0) * BREATHE_AMP;
  float b4 = 1.0 + sin(t * BREATHE_SPEED * 6.28 + 3.0) * BREATHE_AMP;
  float b5 = 1.0 + sin(t * BREATHE_SPEED * 6.28 + 4.0) * BREATHE_AMP;
  float b6 = 1.0 + sin(t * BREATHE_SPEED * 6.28 + 5.0) * BREATHE_AMP;

  vec2 c1 = vec2(cx + sin(t * 0.7) * 0.22,          cy + cos(t * 0.5) * 0.18);
  vec2 c2 = vec2(cx + sin(t * 0.5 + 2.1) * 0.28,    cy + cos(t * 0.65 + 1.3) * 0.22);
  vec2 c3 = vec2(cx + sin(t * 0.6 + 4.2) * 0.18,    cy + cos(t * 0.4 + 3.1) * 0.26);
  vec2 c4 = vec2(cx + sin(t * 0.4 + 1.5) * 0.32,    cy + cos(t * 0.55 + 5.2) * 0.18);
  vec2 c5 = vec2(cx + sin(t * 0.75 + 3.7) * 0.2,    cy + cos(t * 0.35 + 2.4) * 0.24);
  vec2 c6 = vec2(cx + sin(t * 0.35 + 5.5) * 0.26,   cy + cos(t * 0.7 + 0.7) * 0.22);

  float w1 = orb(pos, c1, ORB_RADIUS * 1.0  * b1, 0.0, t);
  float w2 = orb(pos, c2, ORB_RADIUS * 1.15 * b2, 7.3, t);
  float w3 = orb(pos, c3, ORB_RADIUS * 0.9  * b3, 13.1, t);
  float w4 = orb(pos, c4, ORB_RADIUS * 1.1  * b4, 21.7, t);
  float w5 = orb(pos, c5, ORB_RADIUS * 0.85 * b5, 31.3, t);
  float w6 = orb(pos, c6, ORB_RADIUS * 0.95 * b6, 43.9, t);

  float total = w1 + w2 + w3 + w4 + w5 + w6;

  vec3 bg = u_c5;
  vec3 orbCol = (u_c1 * w1 + u_c2 * w2 + u_c3 * w3 + u_c4 * w4 + u_c5 * w5 + u_c6 * w6) / (total + 0.0001);
  float coverage = clamp(total * 1.5, 0.0, 1.0);
  vec3 col = mix(bg, orbCol, coverage);

  float refN = fbm(pos * REFRACT_SCALE + t * 0.3);
  vec2 refOffset = vec2(refN - 0.5) * REFRACT_STR;
  float w1r = orb(pos + refOffset, c1, ORB_RADIUS * 1.0 * b1, 0.0, t);
  float w2r = orb(pos + refOffset, c2, ORB_RADIUS * 1.15 * b2, 7.3, t);
  float totalR = w1r + w2r;
  float refractBlend = clamp(totalR * 2.0, 0.0, 1.0);
  vec3 refractCol = mix(u_c3, u_c1, refN);
  col = mix(col, refractCol, refractBlend * 0.15);

  float grain = hash(uv * u_resolution.xy + fract(u_time) * 1000.0) - 0.5;
  col += grain * 0.025;

  float vig = pow(16.0 * uv.x * uv.y * (1.0 - uv.x) * (1.0 - uv.y), 0.4);
  col = mix(bg * 0.92, col, vig);

  gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);
}
