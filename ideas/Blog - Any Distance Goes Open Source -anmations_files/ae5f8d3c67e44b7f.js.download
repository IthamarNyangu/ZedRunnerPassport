`,to=`
#ifdef GL_FRAGMENT_PRECISION_HIGH
  precision highp float;
#else
  precision mediump float;
#endif

varying vec2 v_uv;

uniform float u_time;
uniform vec2 u_resolution;
uniform int u_variant;
uniform vec3 u_color1;
uniform vec3 u_color2;
uniform vec3 u_color3;
uniform vec3 u_color4;
uniform vec3 u_color5;
uniform vec3 u_color6;
uniform float u_grain;

float hash(vec2 p) {
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
}

float noise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  vec2 u = f * f * (3.0 - 2.0 * f);

  return mix(
    mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
    mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
    u.y
  );
}

float fbm(vec2 p) {
  float value = 0.0;
  float amplitude = 0.5;
  mat2 rotation = mat2(0.8, 0.6, -0.6, 0.8);

  for (int i = 0; i < 5; i++) {
    value += amplitude * noise(p);
    p = rotation * p * 2.03;
    amplitude *= 0.5;
  }

  return value;
}

vec2 rotate(vec2 p, float angle) {
  float c = cos(angle);
  float s = sin(angle);
  return vec2(c * p.x - s * p.y, s * p.x + c * p.y);
}

float cubicBezierY(float t, float y1, float y2) {
  float x = clamp(t, 0.0, 1.0);
  float inv = 1.0 - x;
  return 3.0 * inv * inv * x * y1 + 3.0 * inv * x * x * y2 + x * x * x;
}

vec3 paletteRamp(float ramp) {
  float r = clamp(ramp, 0.0, 1.0);

  if (r < 0.2) {
    return mix(u_color1, u_color2, smoothstep(0.0, 0.2, r));
  } else if (r < 0.4) {
    return mix(u_color2, u_color3, smoothstep(0.2, 0.4, r));
  } else if (r < 0.6) {
    return mix(u_color3, u_color4, smoothstep(0.4, 0.6, r));
  } else if (r < 0.8) {
    return mix(u_color4, u_color5, smoothstep(0.6, 0.8, r));
  }

  return mix(u_color5, u_color6, smoothstep(0.8, 1.0, r));
}

float grain(vec2 uv, float t) {
  return hash(uv * u_resolution.xy + fract(t) * 1000.0) - 0.5;
}

// Simplex 2D noise from Ashima Arts (MIT). Kept separate from the hash fbm used
// by the other single-color primitives so smoothNoise preserves Avec's texture.
vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec2 mod289v2(vec2 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec3 permute(vec3 x) { return mod289(((x * 34.0) + 1.0) * x); }

float snoise(vec2 v) {
  const vec4 C = vec4(
    0.211324865405187,
    0.366025403784439,
    -0.577350269189626,
    0.024390243902439
  );

  vec2 i = floor(v + dot(v, C.yy));
  vec2 x0 = v - i + dot(i, C.xx);

  vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
  vec4 x12 = x0.xyxy + C.xxzz;
  x12.xy -= i1;

  i = mod289v2(i);
  vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0)) + i.x + vec3(0.0, i1.x, 1.0));

  vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
  m = m * m;
  m = m * m;

  vec3 x = 2.0 * fract(p * C.www) - 1.0;
  vec3 h = abs(x) - 0.5;
  vec3 ox = floor(x + 0.5);
  vec3 a0 = x - ox;

  m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);

  vec3 g;
  g.x = a0.x * x0.x + h.x * x0.y;
  g.yz = a0.yz * x12.xz + h.yz * x12.yw;

  return 130.0 * dot(m, g);
}

float smoothFbm(vec2 p) {
  float val = 0.0;
  float amp = 0.65;
  for (int i = 0; i < 2; i++) {
    val += amp * snoise(p);
    p *= 1.6;
    amp *= 0.35;
  }
  return val;
}

vec3 rgb2hsl(vec3 c) {
  float maxC = max(c.r, max(c.g, c.b));
  float minC = min(c.r, min(c.g, c.b));
  float l = (maxC + minC) * 0.5;
  if (maxC == minC) return vec3(0.0, 0.0, l);
  float d = maxC - minC;
  float s = l > 0.5 ? d / (2.0 - maxC - minC) : d / (maxC + minC);
  float h;
  if (maxC == c.r) h = (c.g - c.b) / d + (c.g < c.b ? 6.0 : 0.0);
  else if (maxC == c.g) h = (c.b - c.r) / d + 2.0;
  else h = (c.r - c.g) / d + 4.0;
  h /= 6.0;
  return vec3(h, s, l);
}

float hue2rgb(float p, float q, float t) {
  if (t < 0.0) t += 1.0;
  if (t > 1.0) t -= 1.0;
  if (t < 1.0/6.0) return p + (q - p) * 6.0 * t;
  if (t < 1.0/2.0) return q;
  if (t < 2.0/3.0) return p + (q - p) * (2.0/3.0 - t) * 6.0;
  return p;
}

vec3 hsl2rgb(vec3 hsl) {
  if (hsl.y == 0.0) return vec3(hsl.z);
  float q = hsl.z < 0.5 ? hsl.z * (1.0 + hsl.y) : hsl.z + hsl.y - hsl.z * hsl.y;
  float p = 2.0 * hsl.z - q;
  return vec3(
    hue2rgb(p, q, hsl.x + 1.0/3.0),
    hue2rgb(p, q, hsl.x),
    hue2rgb(p, q, hsl.x - 1.0/3.0)
  );
}

vec3 hueShift(vec3 col, float hShift, float sMult) {
  vec3 hsl = rgb2hsl(col);
  hsl.x = fract(hsl.x + hShift);
  hsl.y = clamp(hsl.y * sMult, 0.0, 1.0);
  return hsl2rgb(hsl);
}

vec3 smoothNoise(vec2 uv, float t) {
  float aspect = u_resolution.x / u_resolution.y;
  vec2 uvA = vec2(uv.x * aspect, uv.y);

  float avecTime = t * 1.5 + 40.0;

  vec2 center = vec2(0.5 * aspect, 0.5);
  vec2 centered = uvA - center;

  vec3 bgColor = mix(u_color1, u_color6, 0.5) * 0.9;
  vec3 col = bgColor;

  vec2 stretch = vec2(0.55, 1.8);

  float slowAngle = avecTime * 0.16;
  vec2 rotatedUV = rotate(centered, slowAngle) + center;
  float warpX = snoise(rotatedUV * stretch * 0.15 + vec2(sin(avecTime * 0.07) * 0.25, cos(avecTime * 0.09) * 0.25));
  float warpY = snoise(rotatedUV * stretch * 0.15 + vec2(cos(avecTime * 0.08) * 0.25, sin(avecTime * 0.06) * 0.25) + 50.0);
  vec2 distortedUVA = uvA + vec2(warpX, warpY) * 0.2;

  vec2 noiseUV = distortedUVA * stretch;

  vec2 rotNoiseUV = rotate(noiseUV - center, avecTime * 0.065) + center;
  float n1raw = smoothFbm(rotNoiseUV * 0.075);
  float n1 = smoothstep(0.38, 0.62, n1raw * 0.5 + 0.5);

  vec2 rotNoiseUV2 = rotate(noiseUV - center, avecTime * -0.055 + 2.0) + center;
  float n2raw = smoothFbm(rotNoiseUV2 * 0.095);
  float n2 = smoothstep(0.38, 0.62, n2raw * 0.5 + 0.5);

  vec3 palette = paletteRamp(n1);
  vec3 palette2 = mix(u_color1, u_color4, n2);
  palette = mix(palette, palette2, 0.15);

  float hueNoise = snoise(distortedUVA * 1.5 + avecTime * 0.025) * 0.12;
  float satNoise = 1.0 + snoise(distortedUVA * 1.2 + avecTime * 0.035 + 10.0) * 0.2;
  palette = hueShift(palette, hueNoise, satNoise);

  palette = pow(palette, vec3(0.75));

  float intensity = smoothstep(0.0, 0.4, n1);
  col = mix(bgColor, palette, 0.7 + intensity * 0.3);

  vec2 circleCenter = center + vec2(
    sin(avecTime * 0.1 + 1.0) * 0.12,
    cos(avecTime * 0.08 + 2.0) * 0.1
  );
  float dist = length(distortedUVA - circleCenter);
  float circleMask = 1.0 - smoothstep(0.0, 0.7, dist);
  vec3 circleColor = mix(u_color5, u_color3, 0.4);
  col = mix(col, circleColor, circleMask * 0.4);

  vec2 blob2Center = center + vec2(
    cos(avecTime * 0.09 + 4.0) * 0.18,
    sin(avecTime * 0.11 + 3.0) * 0.14
  );
  float dist2 = length(distortedUVA - blob2Center);
  float blob2Mask = 1.0 - smoothstep(0.0, 0.6, dist2);
  col = mix(col, u_color2, blob2Mask * 0.35);

  vec2 blob3Center = center + vec2(
    sin(avecTime * 0.065 + 6.0) * 0.2,
    cos(avecTime * 0.08 + 5.0) * 0.16
  );
  float dist3 = length(distortedUVA - blob3Center);
  float blob3Mask = 1.0 - smoothstep(0.0, 0.55, dist3);
  col = mix(col, u_color6, blob3Mask * 0.25);

  vec2 rotBlendUV = rotate(distortedUVA - center, avecTime * 0.03) + center;
  float blendNoise = snoise(rotBlendUV * 0.5);
  float blendFactor = smoothstep(-0.3, 0.3, blendNoise);
  vec3 warmBlend = mix(u_color1, u_color5, blendFactor);
  col = mix(col, warmBlend, 0.15);

  float g = fract(sin(dot(uv * u_resolution, vec2(12.9898, 78.233)) + avecTime * 43.758) * 43758.5453);
  col += (g - 0.5) * u_grain;

  col = mix(col, vec3(1.0), 0.18);

  return clamp(col, 0.0, 1.0);
}

vec3 bottomGradient(vec2 uv, float t) {
  float aspect = u_resolution.x / u_resolution.y;
  vec2 p = (uv - 0.5) * vec2(aspect, 1.0);

  float shimmer = fbm(vec2(p.x * 1.25, uv.y * 1.5) + vec2(t * 0.16, -t * 0.11));
  float shimmer2 = fbm(vec2(p.x * 0.72, uv.y * 1.05) + vec2(-t * 0.1, t * 0.14) + 4.7);

  float boundary = 0.34
    + sin(p.x * 1.85 + shimmer * 2.8 + t * 0.74) * 0.055
    + sin(p.x * 0.82 - t * 0.38 + shimmer2 * 1.4) * 0.034;
  float transitionTop = boundary + 0.18;
  float transitionBottom = boundary - 0.18;
  float bottomRamp = clamp((transitionTop - uv.y) / (transitionTop - transitionBottom), 0.0, 1.0);
  float fromBottom = cubicBezierY(bottomRamp, 0.22, 0.88);
  float bottomCore = pow(fromBottom, 1.1);

  float waveAHeight = 0.18
    + sin(p.x * 2.15 + shimmer * 2.0 + t * 0.68) * 0.07
    + sin(p.x * 0.75 - t * 0.29) * 0.035;
  float waveBHeight = 0.32
    + sin(p.x * 1.35 - shimmer2 * 1.7 - t * 0.48) * 0.08
    + sin(p.x * 2.9 + t * 0.24) * 0.028;
  float bandA = 1.0 - smoothstep(0.0, 0.24, abs(uv.y - waveAHeight));
  float bandB = 1.0 - smoothstep(0.0, 0.31, abs(uv.y - waveBHeight));
  bandA *= 1.0 - smoothstep(0.46, 0.76, uv.y);
  bandB *= 1.0 - smoothstep(0.56, 0.86, uv.y);

  vec3 paper = mix(vec3(1.0), u_color6, 0.08);
  float hueRise = cubicBezierY(bottomRamp, 0.14, 0.86);
  float depthRise = cubicBezierY(bottomRamp, 0.26, 0.94);

  vec3 col = mix(paper, u_color1, hueRise * 0.76);
  col = mix(col, u_color3, depthRise * depthRise * 0.32);
  col = mix(col, u_color2, bandA * hueRise * 0.19);
  col = mix(col, u_color4, bandB * smoothstep(0.06, 0.92, hueRise) * 0.17);

  float lowerGlow = 1.0 - smoothstep(0.0, 0.7, length(p - vec2(sin(t * 0.26) * 0.16, -0.62)));
  col = mix(col, u_color5, lowerGlow * fromBottom * 0.18);
  col = mix(col, u_color6, shimmer2 * bandB * 0.08);
  col += grain(uv, t) * u_grain * (0.35 + fromBottom * 0.65);

  return clamp(col, 0.0, 1.0);
}

vec3 screenBlend(vec3 base, vec3 blend) {
  return 1.0 - (1.0 - base) * (1.0 - blend);
}

vec3 saturateColor(vec3 color, float amount) {
  float luma = dot(color, vec3(0.299, 0.587, 0.114));
  return mix(vec3(luma), color, amount);
}

vec3 spectralFilm(float phase) {
  vec3 wave = clamp(
    0.5 + 0.5 * cos(6.2831853 * (phase + vec3(0.0, 0.34, 0.67))),
    0.0,
    1.0
  );
  vec3 soft = pow(wave, vec3(1.08));
  vec3 punch = pow(smoothstep(0.05, 0.97, wave), vec3(0.78));
  return mix(soft, punch, 0.64);
}

vec4 cornerDispersionLobe(vec2 p, vec2 center, float seed, float t) {
  vec2 fromCenter = p - center;
  vec2 q = rotate(fromCenter, seed + t * (0.32 + seed * 0.025));
  float d = length(q);
  vec2 n = q / max(d, 0.001);
  vec2 tangent = vec2(-n.y, n.x);

  float contour = fbm(q * 0.72 + vec2(seed * 3.1, t * 0.05));
  float micro = fbm(q * 1.62 + vec2(t * 0.08 + seed, -t * 0.06));
  vec2 lightDir = normalize(rotate(normalize(-center), t * 0.42 + seed));
  float prism = dot(n, lightDir);
  float tangentPrism = dot(tangent, lightDir);

  float originMask = smoothstep(0.1, 0.34, d);
  float bandDistance = d + (contour - 0.5) * 0.18 + prism * 0.08;
  float broad = exp(-pow((bandDistance - 0.42) / 0.48, 2.0)) * originMask;
  float rim = exp(-pow((bandDistance - 0.66) / 0.34, 2.0)) * originMask;
  float ribbonCurve = dot(q, lightDir) + sin(dot(q, tangent) * 1.04 + t * 0.24 + seed) * 0.18 + (micro - 0.5) * 0.09;
  float ribbon = exp(-(ribbonCurve * ribbonCurve) / 0.42) * broad * originMask;

  float phase = bandDistance * 0.82 + tangentPrism * 0.5 + contour * 0.34 + seed + t * 0.16;
  float edgePhase = bandDistance * 1.38 - prism * 0.52 + micro * 0.32 + seed * 0.7 + t * 0.14;
  vec3 spectrum = spectralFilm(phase);
  vec3 edgeSpectrum = spectralFilm(edgePhase);

  float causticWave = clamp(
    0.5 + 0.5 * cos(bandDistance * 6.8 + tangentPrism * 1.4 + micro * 0.9 + seed + t * 0.9),
    0.0,
    1.0
  );
  float caustic = pow(causticWave, 1.42) * (rim * 0.58 + ribbon * 0.52);
  float presence = clamp(broad * 0.5 + rim * 0.7 + ribbon * 0.58 + caustic * 0.7, 0.0, 1.0);

  vec3 color = mix(spectrum, edgeSpectrum, 0.48);
  color = mix(color, paletteRamp(fract(phase * 0.32 + seed * 0.17)), 0.16);

  return vec4(color, presence);
}

vec3 iridescentDispersion(vec2 uv, float t) {
  float aspect = u_resolution.x / u_resolution.y;
  vec2 p = (uv - 0.5) * vec2(aspect, 1.0);

  vec2 flow = vec2(
    fbm(p * 0.5 + vec2(t * 0.055, 1.7)),
    fbm(p * 0.46 + vec2(8.2, -t * 0.05))
  ) - 0.5;

  vec2 deviceCenter = vec2(0.0, 0.02);
  vec2 deviceSpace = (p - deviceCenter) / vec2(0.34, 0.66);
  float deviceMask = smoothstep(1.08, 0.72, max(abs(deviceSpace.x), abs(deviceSpace.y)));

  vec3 base = mix(u_color4 * 0.78, u_color1 * 1.04, 0.74);
  base = mix(base, u_color2 * 0.36, smoothstep(0.1, 1.0, uv.y) * 0.08);
  vec3 col = base;

  vec2 warpedP = p + flow * 0.06;
  float xEdge = aspect * 0.5 + 0.035;
  float yEdge = 0.535;
  float sideSlide = 0.24;
  vec2 cornerA = vec2(-xEdge, -0.16 + sin(t * 0.34 + 0.2) * sideSlide);
  vec2 cornerB = vec2(xEdge, 0.16 + sin(t * 0.31 + 2.1) * sideSlide);
  vec2 cornerC = vec2(sin(t * 0.29 + 4.0) * aspect * 0.24, yEdge);
  vec2 cornerD = vec2(sin(t * 0.32 + 5.4) * aspect * 0.24, -yEdge);
  vec4 lobeA = cornerDispersionLobe(warpedP, cornerA, 0.11, t);
  vec4 lobeB = cornerDispersionLobe(warpedP, cornerB, 1.73, t);
  vec4 lobeC = cornerDispersionLobe(warpedP, cornerC, 3.19, t);
  vec4 lobeD = cornerDispersionLobe(warpedP, cornerD, 4.67, t);

  vec3 lobes = vec3(0.0);
  float presence = 0.0;
  lobes += mix(u_color1, lobeA.rgb, 0.58) * lobeA.a;
  presence += lobeA.a;
  lobes += mix(u_color1, lobeB.rgb, 0.58) * lobeB.a;
  presence += lobeB.a;
  lobes += mix(u_color1, lobeC.rgb, 0.58) * lobeC.a;
  presence += lobeC.a;
  lobes += mix(u_color1, lobeD.rgb, 0.58) * lobeD.a;
  presence += lobeD.a;

  lobes /= max(presence, 0.001);
  float dA = length(warpedP - cornerA);
  float dB = length(warpedP - cornerB);
  float dC = length(warpedP - cornerC);
  float dD = length(warpedP - cornerD);
  float interference = (
    sin(dA * 4.2 + t * 0.2) +
    sin(dB * 4.1 - t * 0.18 + 1.3) +
    sin(dC * 4.0 + t * 0.17 + 2.1) +
    sin(dD * 4.3 - t * 0.16 + 3.2)
  ) * 0.25 + 0.5;
  interference = smoothstep(0.2, 0.88, interference);

  float lobeMix = clamp(presence * (0.42 + interference * 0.22), 0.0, 0.86);
  float shadow = clamp(presence * (1.0 - interference) * 0.1, 0.0, 0.16);
  col *= 1.0 - shadow;
  col = mix(col, mix(u_color1, lobes, 0.8), lobeMix);
  col = screenBlend(col, lobes * clamp(presence * (0.24 + interference * 0.14), 0.0, 0.58));
  col = mix(col, u_color1, deviceMask * 0.05);

  float vignette = pow(16.0 * uv.x * uv.y * (1.0 - uv.x) * (1.0 - uv.y), 0.34);
  col = mix(col * 0.88, col, vignette);
  col += grain(uv, t) * u_grain;

  col = saturateColor(clamp(col, 0.0, 1.0), 1.55);
  return pow(clamp(col, 0.0, 1.0), vec3(0.78));
}

void main() {
  float t = u_time;
  vec3 col;

  if (u_variant == 1) {
    col = bottomGradient(v_uv, t);
  } else if (u_variant == 2) {
    col = iridescentDispersion(v_uv, t);
  } else {
    col = smoothNoise(v_uv, t);
  }

  gl_FragColor = vec4(col, 1.0);
}
